local CoreGui = game:GetService("CoreGui")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local Library = {}

function Library:CreateWindow(titleText)
    local guiName = titleText or "Modern Hub"
    if CoreGui:FindFirstChild(guiName) then
        CoreGui[guiName]:Destroy()
    end

    -- НОВАЯ ПАЛИТРА: Onyx & Sky Blue (Современный темный стиль)
    local Colors = {
        Background = Color3.fromRGB(18, 18, 22),
        ElementBG = Color3.fromRGB(26, 26, 32),
        ElementHover = Color3.fromRGB(34, 34, 42),
        Stroke = Color3.fromRGB(50, 50, 60),
        Accent = Color3.fromRGB(0, 170, 255), -- Яркий голубой акцент
        Text = Color3.fromRGB(250, 250, 250),
        TextMuted = Color3.fromRGB(140, 140, 150)
    }

    print("UI Library Initialized")

    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = guiName
    ScreenGui.ResetOnSpawn = false
    ScreenGui.Parent = CoreGui

    local MainFrame = Instance.new("Frame")
    MainFrame.Name = "MainFrame"
    MainFrame.Size = UDim2.new(0, 360, 0, 440) -- Немного увеличил окно для простора
    MainFrame.Position = UDim2.new(0.5, -180, 0.5, -220)
    MainFrame.BackgroundColor3 = Colors.Background
    MainFrame.BorderSizePixel = 0
    MainFrame.ClipsDescendants = true
    MainFrame.Parent = ScreenGui

    local UICorner = Instance.new("UICorner")
    UICorner.CornerRadius = UDim.new(0, 10) -- Мягкие, современные углы
    UICorner.Parent = MainFrame

    local UIStroke = Instance.new("UIStroke")
    UIStroke.Parent = MainFrame
    UIStroke.Color = Colors.Stroke
    UIStroke.Thickness = 1
    UIStroke.Transparency = 0.5

    local TopBar = Instance.new("Frame")
    TopBar.Size = UDim2.new(1, 0, 0, 50)
    TopBar.BackgroundTransparency = 1
    TopBar.Parent = MainFrame

    local Title = Instance.new("TextLabel")
    Title.Size = UDim2.new(1, -60, 1, 0)
    Title.Position = UDim2.new(0, 20, 0, 0)
    Title.BackgroundTransparency = 1
    Title.Text = titleText or "Modern Hub"
    Title.TextColor3 = Colors.Text
    Title.TextSize = 16
    Title.Font = Enum.Font.GothamBold
    Title.TextXAlignment = Enum.TextXAlignment.Left
    Title.Parent = TopBar

    local MinimizeBtn = Instance.new("TextButton")
    MinimizeBtn.Size = UDim2.new(0, 50, 0, 50)
    MinimizeBtn.Position = UDim2.new(1, -50, 0, 0)
    MinimizeBtn.BackgroundTransparency = 1
    MinimizeBtn.Text = "−"
    MinimizeBtn.TextColor3 = Colors.TextMuted
    MinimizeBtn.TextSize = 24
    MinimizeBtn.Font = Enum.Font.GothamBold
    MinimizeBtn.Parent = TopBar

    MinimizeBtn.MouseEnter:Connect(function()
        TweenService:Create(MinimizeBtn, TweenInfo.new(0.2), {TextColor3 = Colors.Accent}):Play()
    end)
    MinimizeBtn.MouseLeave:Connect(function()
        TweenService:Create(MinimizeBtn, TweenInfo.new(0.2), {TextColor3 = Colors.TextMuted}):Play()
    end)

    local Divider = Instance.new("Frame")
    Divider.Size = UDim2.new(1, -40, 0, 1)
    Divider.Position = UDim2.new(0, 20, 1, 0)
    Divider.BackgroundColor3 = Colors.Stroke
    Divider.BorderSizePixel = 0
    Divider.Parent = TopBar

    local ScrollFrame = Instance.new("ScrollingFrame")
    ScrollFrame.Size = UDim2.new(1, 0, 1, -65)
    ScrollFrame.Position = UDim2.new(0, 0, 0, 55)
    ScrollFrame.BackgroundTransparency = 1
    ScrollFrame.ScrollBarThickness = 2
    ScrollFrame.ScrollBarImageColor3 = Colors.Accent
    ScrollFrame.BorderSizePixel = 0
    ScrollFrame.Parent = MainFrame

    local UIPadding = Instance.new("UIPadding")
    UIPadding.PaddingLeft = UDim.new(0, 20)
    UIPadding.PaddingRight = UDim.new(0, 20)
    UIPadding.PaddingTop = UDim.new(0, 10)
    UIPadding.PaddingBottom = UDim.new(0, 15)
    UIPadding.Parent = ScrollFrame

    local UIListLayout = Instance.new("UIListLayout")
    UIListLayout.Padding = UDim.new(0, 10)
    UIListLayout.SortOrder = Enum.SortOrder.LayoutOrder
    UIListLayout.Parent = ScrollFrame

    UIListLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        ScrollFrame.CanvasSize = UDim2.new(0, 0, 0, UIListLayout.AbsoluteContentSize.Y + 25)
    end)

    -- Улучшенный Dragging (Перетаскивание)
    local dragging, dragInput, dragStart, startPos
    TopBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = MainFrame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    TopBar.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then dragInput = input end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            TweenService:Create(MainFrame, TweenInfo.new(0.1, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
                Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            }):Play()
        end
    end)

    -- Сворачивание / Разворачивание
    local minimized = false
    MinimizeBtn.MouseButton1Click:Connect(function()
        minimized = not minimized
        if minimized then
            MinimizeBtn.Text = "+"
            TweenService:Create(MinimizeBtn, TweenInfo.new(0.3), {Rotation = 90}):Play()
            TweenService:Create(ScrollFrame, TweenInfo.new(0.2), {ScrollBarImageTransparency = 1}):Play()
            ScrollFrame.Visible = false
            TweenService:Create(MainFrame, TweenInfo.new(0.4, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), {Size = UDim2.new(0, 360, 0, 50)}):Play()
        else
            MinimizeBtn.Text = "−"
            TweenService:Create(MinimizeBtn, TweenInfo.new(0.3), {Rotation = 0}):Play()
            TweenService:Create(MainFrame, TweenInfo.new(0.4, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), {Size = UDim2.new(0, 360, 0, 440)}):Play()
            task.wait(0.1)
            ScrollFrame.Visible = true
            TweenService:Create(ScrollFrame, TweenInfo.new(0.3), {ScrollBarImageTransparency = 0}):Play()
        end
    end)

    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if not gameProcessed and input.KeyCode == Enum.KeyCode.RightShift then
            ScreenGui.Enabled = not ScreenGui.Enabled
        end
    end)

    local Window = {}

    -- 1. TOGGLE (Переключатель)
    function Window:AddToggle(data)
        local text = data.text or "Toggle"
        local defaultState = data.state or false
        local callback = data.callback or function() end

        local ToggleFrame = Instance.new("TextButton")
        ToggleFrame.Size = UDim2.new(1, 0, 0, 42)
        ToggleFrame.BackgroundColor3 = Colors.ElementBG
        ToggleFrame.AutoButtonColor = false
        ToggleFrame.Text = ""
        ToggleFrame.Parent = ScrollFrame
        Instance.new("UICorner", ToggleFrame).CornerRadius = UDim.new(0, 6)
        
        local Stroke = Instance.new("UIStroke", ToggleFrame)
        Stroke.Color = Colors.Stroke
        Stroke.Transparency = 0.5

        local Label = Instance.new("TextLabel")
        Label.Size = UDim2.new(1, -70, 1, 0)
        Label.Position = UDim2.new(0, 15, 0, 0)
        Label.BackgroundTransparency = 1
        Label.Text = text
        Label.TextColor3 = Colors.Text
        Label.TextSize = 13
        Label.Font = Enum.Font.GothamMedium
        Label.TextXAlignment = Enum.TextXAlignment.Left
        Label.Parent = ToggleFrame

        local ToggleBG = Instance.new("Frame")
        ToggleBG.Size = UDim2.new(0, 38, 0, 20)
        ToggleBG.Position = UDim2.new(1, -50, 0.5, -10)
        ToggleBG.BackgroundColor3 = defaultState and Colors.Accent or Colors.Background
        ToggleBG.Parent = ToggleFrame
        Instance.new("UICorner", ToggleBG).CornerRadius = UDim.new(1, 0)
        Instance.new("UIStroke", ToggleBG).Color = Colors.Stroke

        local Circle = Instance.new("Frame")
        Circle.Size = UDim2.new(0, 14, 0, 14)
        Circle.Position = UDim2.new(defaultState and 1 or 0, defaultState and -17 or 3, 0.5, -7)
        Circle.BackgroundColor3 = Colors.Text
        Circle.Parent = ToggleBG
        Instance.new("UICorner", Circle).CornerRadius = UDim.new(1, 0)

        ToggleFrame.MouseEnter:Connect(function()
            TweenService:Create(ToggleFrame, TweenInfo.new(0.2), {BackgroundColor3 = Colors.ElementHover}):Play()
        end)
        ToggleFrame.MouseLeave:Connect(function()
            TweenService:Create(ToggleFrame, TweenInfo.new(0.2), {BackgroundColor3 = Colors.ElementBG}):Play()
        end)

        local state = defaultState
        ToggleFrame.MouseButton1Click:Connect(function()
            state = not state
            local targetColor = state and Colors.Accent or Colors.Background
            local targetPos = state and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)
            
            TweenService:Create(ToggleBG, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {BackgroundColor3 = targetColor}):Play()
            TweenService:Create(Circle, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = targetPos}):Play()
            callback(state)
        end)
    end

    -- 2. BUTTON (Кнопка)
    function Window:AddButton(data)
        local text = data.text or "Button"
        local callback = data.callback or function() end

        local Button = Instance.new("TextButton")
        Button.Size = UDim2.new(1, 0, 0, 42)
        Button.BackgroundColor3 = Colors.ElementBG
        Button.Text = text
        Button.TextColor3 = Colors.Text
        Button.TextSize = 13
        Button.Font = Enum.Font.GothamMedium
        Button.AutoButtonColor = false
        Button.Parent = ScrollFrame
        Instance.new("UICorner", Button).CornerRadius = UDim.new(0, 6)
        
        local Stroke = Instance.new("UIStroke", Button)
        Stroke.Color = Colors.Stroke
        Stroke.Transparency = 0.5

        Button.MouseEnter:Connect(function()
            TweenService:Create(Button, TweenInfo.new(0.2), {BackgroundColor3 = Colors.ElementHover}):Play()
        end)
        Button.MouseLeave:Connect(function()
            TweenService:Create(Button, TweenInfo.new(0.2), {BackgroundColor3 = Colors.ElementBG}):Play()
        end)
        Button.MouseButton1Down:Connect(function()
            TweenService:Create(Button, TweenInfo.new(0.1), {TextSize = 11, BackgroundColor3 = Colors.Background}):Play()
        end)
        Button.MouseButton1Up:Connect(function()
            TweenService:Create(Button, TweenInfo.new(0.1), {TextSize = 13, BackgroundColor3 = Colors.ElementHover}):Play()
        end)
        Button.MouseButton1Click:Connect(callback)
    end

    -- 3. НОВОЕ ПОЛЕ ВВОДА (Modern Input)
    function Window:AddInput(data)
        local text = data.text or "Input"
        local placeholder = data.placeholder or "Type here..."
        local callback = data.callback or function() end

        local InputFrame = Instance.new("Frame")
        InputFrame.Size = UDim2.new(1, 0, 0, 55) -- Чуть выше для размещения текста над инпутом
        InputFrame.BackgroundColor3 = Colors.ElementBG
        InputFrame.BackgroundTransparency = 1
        InputFrame.Parent = ScrollFrame

        local Label = Instance.new("TextLabel")
        Label.Size = UDim2.new(1, 0, 0, 15)
        Label.Position = UDim2.new(0, 5, 0, 0)
        Label.BackgroundTransparency = 1
        Label.Text = text
        Label.TextColor3 = Colors.Text
        Label.TextSize = 12
        Label.Font = Enum.Font.GothamMedium
        Label.TextXAlignment = Enum.TextXAlignment.Left
        Label.Parent = InputFrame

        local TextBoxContainer = Instance.new("Frame")
        TextBoxContainer.Size = UDim2.new(1, 0, 0, 36)
        TextBoxContainer.Position = UDim2.new(0, 0, 0, 19)
        TextBoxContainer.BackgroundColor3 = Colors.ElementBG
        TextBoxContainer.Parent = InputFrame
        Instance.new("UICorner", TextBoxContainer).CornerRadius = UDim.new(0, 6)
        
        local Stroke = Instance.new("UIStroke", TextBoxContainer)
        Stroke.Color = Colors.Stroke
        Stroke.Thickness = 1.2

        local TextBox = Instance.new("TextBox")
        TextBox.Size = UDim2.new(1, -20, 1, 0)
        TextBox.Position = UDim2.new(0, 10, 0, 0)
        TextBox.BackgroundTransparency = 1
        TextBox.Text = ""
        TextBox.PlaceholderText = placeholder
        TextBox.PlaceholderColor3 = Colors.TextMuted
        TextBox.TextColor3 = Colors.Text
        TextBox.TextSize = 12
        TextBox.Font = Enum.Font.Gotham
        TextBox.TextXAlignment = Enum.TextXAlignment.Left
        TextBox.Parent = TextBoxContainer

        -- Анимации фокуса для нового поля ввода
        TextBox.Focused:Connect(function()
            TweenService:Create(Stroke, TweenInfo.new(0.3), {Color = Colors.Accent}):Play()
            TweenService:Create(TextBoxContainer, TweenInfo.new(0.3), {BackgroundColor3 = Colors.ElementHover}):Play()
        end)

        TextBox.FocusLost:Connect(function()
            TweenService:Create(Stroke, TweenInfo.new(0.3), {Color = Colors.Stroke}):Play()
            TweenService:Create(TextBoxContainer, TweenInfo.new(0.3), {BackgroundColor3 = Colors.ElementBG}):Play()
            callback(TextBox.Text)
        end)
    end

    -- 4. SLIDER (Ползунок)
    function Window:AddSlider(data)
        local text = data.text or "Slider"
        local min = data.min or 0
        local max = data.max or 100
        local default = data.default or min
        local callback = data.callback or function() end

        local SliderFrame = Instance.new("Frame")
        SliderFrame.Size = UDim2.new(1, 0, 0, 50)
        SliderFrame.BackgroundColor3 = Colors.ElementBG
        SliderFrame.Parent = ScrollFrame
        Instance.new("UICorner", SliderFrame).CornerRadius = UDim.new(0, 6)
        
        local Stroke = Instance.new("UIStroke", SliderFrame)
        Stroke.Color = Colors.Stroke
        Stroke.Transparency = 0.5

        local Label = Instance.new("TextLabel")
        Label.Size = UDim2.new(1, -30, 0, 24)
        Label.Position = UDim2.new(0, 15, 0, 3)
        Label.BackgroundTransparency = 1
        Label.Text = text
        Label.TextColor3 = Colors.Text
        Label.TextSize = 13
        Label.Font = Enum.Font.GothamMedium
        Label.TextXAlignment = Enum.TextXAlignment.Left
        Label.Parent = SliderFrame

        local ValueLabel = Instance.new("TextLabel")
        ValueLabel.Size = UDim2.new(0, 50, 0, 24)
        ValueLabel.Position = UDim2.new(1, -65, 0, 3)
        ValueLabel.BackgroundTransparency = 1
        ValueLabel.Text = tostring(default)
        ValueLabel.TextColor3 = Colors.Accent
        ValueLabel.TextSize = 13
        ValueLabel.Font = Enum.Font.GothamBold
        ValueLabel.TextXAlignment = Enum.TextXAlignment.Right
        ValueLabel.Parent = SliderFrame

        local SliderBG = Instance.new("TextButton")
        SliderBG.Size = UDim2.new(1, -30, 0, 6)
        SliderBG.Position = UDim2.new(0, 15, 0, 34)
        SliderBG.BackgroundColor3 = Colors.Background
        SliderBG.Text = ""
        SliderBG.AutoButtonColor = false
        SliderBG.Parent = SliderFrame
        Instance.new("UICorner", SliderBG).CornerRadius = UDim.new(1, 0)
        Instance.new("UIStroke", SliderBG).Color = Colors.Stroke

        local Fill = Instance.new("Frame")
        Fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
        Fill.BackgroundColor3 = Colors.Accent
        Fill.Parent = SliderBG
        Instance.new("UICorner", Fill).CornerRadius = UDim.new(1, 0)

        local dragging = false
        local function UpdateSlider(input)
            local pos = math.clamp((input.Position.X - SliderBG.AbsolutePosition.X) / SliderBG.AbsoluteSize.X, 0, 1)
            local value = math.floor(min + ((max - min) * pos))
            TweenService:Create(Fill, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.new(pos, 0, 1, 0)}):Play()
            ValueLabel.Text = tostring(value)
            callback(value)
        end

        SliderBG.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                UpdateSlider(input)
            end
        end)

        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)

        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                UpdateSlider(input)
            end
        end)
    end

    -- 5. LABEL (Текст)
    function Window:AddLabel(data)
        local text = data.text or "Label"

        local LabelFrame = Instance.new("Frame")
        LabelFrame.Size = UDim2.new(1, 0, 0, 30)
        LabelFrame.BackgroundTransparency = 1
        LabelFrame.Parent = ScrollFrame

        local Label = Instance.new("TextLabel")
        Label.Size = UDim2.new(1, 0, 1, 0)
        Label.BackgroundTransparency = 1
        Label.Text = text
        Label.TextColor3 = Colors.TextMuted
        Label.TextSize = 12
        Label.Font = Enum.Font.Gotham
        Label.TextXAlignment = Enum.TextXAlignment.Center
        Label.Parent = LabelFrame
    end

    function Window:Init()
        -- Инициализация
    end

    return Window
end

return Library
