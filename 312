local CoreGui = game:GetService("CoreGui")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local Library = {}

function Library:CreateWindow(titleText)
    -- Поддержка и старого вызова (строка), и очень старого (таблица), чтобы точно ничего не сломалось
    local actualTitle = type(titleText) == "table" and (titleText.Name or titleText.text or "Baobab Hub") or titleText or "Baobab Hub"
    local guiName = actualTitle

    if CoreGui:FindFirstChild(guiName) then
        CoreGui[guiName]:Destroy()
    end

    -- Палитра "Cyber Onyx"
    local Colors = {
        Background = Color3.fromRGB(14, 14, 18),
        Grid = Color3.fromRGB(25, 25, 30),
        ElementBG = Color3.fromRGB(22, 22, 28),
        ElementHover = Color3.fromRGB(30, 30, 38),
        Stroke = Color3.fromRGB(45, 45, 55),
        Accent = Color3.fromRGB(99, 102, 241),
        Text = Color3.fromRGB(250, 250, 250),
        TextMuted = Color3.fromRGB(140, 140, 150)
    }

    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = guiName
    ScreenGui.ResetOnSpawn = false
    ScreenGui.Parent = CoreGui

    local MainFrame = Instance.new("Frame")
    MainFrame.Name = "MainFrame"
    MainFrame.Size = UDim2.new(0, 350, 0, 430)
    MainFrame.Position = UDim2.new(0.5, -175, 0.5, -215)
    MainFrame.BackgroundColor3 = Colors.Background
    MainFrame.BorderSizePixel = 0
    MainFrame.ClipsDescendants = true
    MainFrame.Parent = ScreenGui

    local UICorner = Instance.new("UICorner")
    UICorner.CornerRadius = UDim.new(0, 10)
    UICorner.Parent = MainFrame

    local UIStroke = Instance.new("UIStroke")
    UIStroke.Parent = MainFrame
    UIStroke.Color = Colors.Stroke
    UIStroke.Thickness = 1.5

    -- Добавляем точечный паттерн на фон (Grid Pattern)
    local GridPattern = Instance.new("ImageLabel")
    GridPattern.Size = UDim2.new(1, 0, 1, 0)
    GridPattern.BackgroundTransparency = 1
    GridPattern.Image = "rbxassetid://6328221805" -- Текстура точек
    GridPattern.ImageTransparency = 0.85
    GridPattern.ImageColor3 = Colors.Grid
    GridPattern.ScaleType = Enum.ScaleType.Tile
    GridPattern.TileSize = UDim2.new(0, 25, 0, 25)
    GridPattern.Parent = MainFrame

    local TopBar = Instance.new("Frame")
    TopBar.Size = UDim2.new(1, 0, 0, 45)
    TopBar.BackgroundTransparency = 1
    TopBar.Parent = MainFrame

    local Title = Instance.new("TextLabel")
    Title.Size = UDim2.new(1, -60, 1, 0)
    Title.Position = UDim2.new(0, 20, 0, 0)
    Title.BackgroundTransparency = 1
    Title.Text = actualTitle
    Title.TextColor3 = Colors.Text
    Title.TextSize = 16
    Title.Font = Enum.Font.GothamBold
    Title.TextXAlignment = Enum.TextXAlignment.Left
    Title.Parent = TopBar

    local MinimizeBtn = Instance.new("TextButton")
    MinimizeBtn.Size = UDim2.new(0, 45, 0, 45)
    MinimizeBtn.Position = UDim2.new(1, -45, 0, 0)
    MinimizeBtn.BackgroundTransparency = 1
    MinimizeBtn.Text = "—"
    MinimizeBtn.TextColor3 = Colors.TextMuted
    MinimizeBtn.TextSize = 18
    MinimizeBtn.Font = Enum.Font.GothamBold
    MinimizeBtn.Parent = TopBar

    local BottomLabel = Instance.new("TextLabel")
    BottomLabel.Size = UDim2.new(1, 0, 0, 30)
    BottomLabel.Position = UDim2.new(0, 0, 0, 400) 
    BottomLabel.BackgroundTransparency = 1
    BottomLabel.Text = "discord.gg/CVxS3dH5fz"
    BottomLabel.TextColor3 = Colors.TextMuted
    BottomLabel.TextSize = 11
    BottomLabel.Font = Enum.Font.GothamMedium
    BottomLabel.Parent = MainFrame

    local ScrollFrame = Instance.new("ScrollingFrame")
    ScrollFrame.Size = UDim2.new(1, 0, 0, 350)
    ScrollFrame.Position = UDim2.new(0, 0, 0, 50)
    ScrollFrame.BackgroundTransparency = 1
    ScrollFrame.ScrollBarThickness = 1 -- Почти невидимый стильный скролл
    ScrollFrame.ScrollBarImageColor3 = Colors.Accent
    ScrollFrame.BorderSizePixel = 0
    ScrollFrame.Parent = MainFrame

    local UIPadding = Instance.new("UIPadding")
    UIPadding.PaddingLeft = UDim.new(0, 15)
    UIPadding.PaddingRight = UDim.new(0, 15)
    UIPadding.PaddingTop = UDim.new(0, 5)
    UIPadding.PaddingBottom = UDim.new(0, 15)
    UIPadding.Parent = ScrollFrame

    local UIListLayout = Instance.new("UIListLayout")
    UIListLayout.Padding = UDim.new(0, 10)
    UIListLayout.SortOrder = Enum.SortOrder.LayoutOrder
    UIListLayout.Parent = ScrollFrame

    UIListLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        ScrollFrame.CanvasSize = UDim2.new(0, 0, 0, UIListLayout.AbsoluteContentSize.Y + 20)
    end)

    -- Улучшенная физика перетаскивания (смягченная)
    local dragging, dragInput, dragStart, startPos
    TopBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = MainFrame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    TopBar.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then dragInput = input end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            TweenService:Create(MainFrame, TweenInfo.new(0.1, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
                Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            }):Play()
        end
    end)

    -- Классическая система сворачивания
    local minimized = false
    MinimizeBtn.MouseButton1Click:Connect(function()
        minimized = not minimized
        if minimized then
            MinimizeBtn.Text = "+"
            TweenService:Create(MinimizeBtn, TweenInfo.new(0.3), {Rotation = 90}):Play()
            
            TweenService:Create(BottomLabel, TweenInfo.new(0.15), {TextTransparency = 1}):Play()
            TweenService:Create(ScrollFrame, TweenInfo.new(0.15), {ScrollBarImageTransparency = 1}):Play()
            
            task.wait(0.15)
            ScrollFrame.Visible = false
            BottomLabel.Visible = false
            
            TweenService:Create(MainFrame, TweenInfo.new(0.4, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), {
                Size = UDim2.new(0, 350, 0, 45)
            }):Play()
        else
            MinimizeBtn.Text = "—"
            TweenService:Create(MinimizeBtn, TweenInfo.new(0.3), {Rotation = 0}):Play()
            
            TweenService:Create(MainFrame, TweenInfo.new(0.4, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), {
                Size = UDim2.new(0, 350, 0, 430)
            }):Play()
            
            task.wait(0.2)
            ScrollFrame.Visible = true
            BottomLabel.Visible = true
            
            TweenService:Create(BottomLabel, TweenInfo.new(0.3), {TextTransparency = 0}):Play()
            TweenService:Create(ScrollFrame, TweenInfo.new(0.3), {ScrollBarImageTransparency = 0}):Play()
        end
    end)

    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if not gameProcessed and input.KeyCode == Enum.KeyCode.RightShift then
            ScreenGui.Enabled = not ScreenGui.Enabled
        end
    end)

    -- ФУНКЦИЯ ЭФФЕКТА РЯБИ ДЛЯ КНОПОК
    local function CreateRipple(button, x, y)
        spawn(function()
            local Ripple = Instance.new("Frame")
            Ripple.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            Ripple.AnchorPoint = Vector2.new(0.5, 0.5)
            Ripple.Size = UDim2.new(0, 0, 0, 0)
            Ripple.Position = UDim2.new(0, x - button.AbsolutePosition.X, 0, y - button.AbsolutePosition.Y)
            Ripple.BackgroundTransparency = 0.8
            Instance.new("UICorner", Ripple).CornerRadius = UDim.new(1, 0)
            Ripple.Parent = button

            local tween = TweenService:Create(Ripple, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Size = UDim2.new(0, button.AbsoluteSize.X * 2, 0, button.AbsoluteSize.X * 2),
                BackgroundTransparency = 1
            })
            tween:Play()
            tween.Completed:Wait()
            Ripple:Destroy()
        end)
    end

    local Window = {}

    function Window:AddToggle(data)
        local text = data.text or "Toggle"
        local defaultState = data.state or false
        local callback = data.callback or function() end

        local ToggleFrame = Instance.new("TextButton")
        ToggleFrame.Size = UDim2.new(1, 0, 0, 45)
        ToggleFrame.BackgroundColor3 = Colors.ElementBG
        ToggleFrame.AutoButtonColor = false
        ToggleFrame.Text = ""
        ToggleFrame.ClipsDescendants = true
        ToggleFrame.Parent = ScrollFrame
        Instance.new("UICorner", ToggleFrame).CornerRadius = UDim.new(0, 8)
        local TStroke = Instance.new("UIStroke", ToggleFrame)
        TStroke.Color = Colors.Stroke

        local Label = Instance.new("TextLabel")
        Label.Size = UDim2.new(1, -70, 1, 0)
        Label.Position = UDim2.new(0, 15, 0, 0)
        Label.BackgroundTransparency = 1
        Label.Text = text
        Label.TextColor3 = Colors.Text
        Label.TextSize = 14
        Label.Font = Enum.Font.GothamMedium
        Label.TextXAlignment = Enum.TextXAlignment.Left
        Label.Parent = ToggleFrame

        local ToggleBG = Instance.new("Frame")
        ToggleBG.Size = UDim2.new(0, 42, 0, 22)
        ToggleBG.Position = UDim2.new(1, -55, 0.5, -11)
        ToggleBG.BackgroundColor3 = defaultState and Colors.Accent or Colors.Background
        ToggleBG.Parent = ToggleFrame
        Instance.new("UICorner", ToggleBG).CornerRadius = UDim.new(1, 0)
        local BgStroke = Instance.new("UIStroke", ToggleBG)
        BgStroke.Color = Colors.Stroke

        local Circle = Instance.new("Frame")
        Circle.Size = UDim2.new(0, 16, 0, 16)
        Circle.Position = UDim2.new(defaultState and 1 or 0, defaultState and -19 or 3, 0.5, -8)
        Circle.BackgroundColor3 = Colors.Text
        Circle.Parent = ToggleBG
        Instance.new("UICorner", Circle).CornerRadius = UDim.new(1, 0)

        ToggleFrame.MouseEnter:Connect(function() TweenService:Create(ToggleFrame, TweenInfo.new(0.2), {BackgroundColor3 = Colors.ElementHover}):Play() end)
        ToggleFrame.MouseLeave:Connect(function() TweenService:Create(ToggleFrame, TweenInfo.new(0.2), {BackgroundColor3 = Colors.ElementBG}):Play() end)

        local state = defaultState
        ToggleFrame.MouseButton1Click:Connect(function()
            local mouseLoc = UserInputService:GetMouseLocation()
            CreateRipple(ToggleFrame, mouseLoc.X, mouseLoc.Y - 36)

            state = not state
            TweenService:Create(ToggleBG, TweenInfo.new(0.4, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), {BackgroundColor3 = state and Colors.Accent or Colors.Background}):Play()
            TweenService:Create(Circle, TweenInfo.new(0.5, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), {Position = state and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)}):Play()
            TweenService:Create(BgStroke, TweenInfo.new(0.2), {Transparency = state and 1 or 0}):Play()
            callback(state)
        end)
    end

    function Window:AddButton(data)
        local text = data.text or "Button"
        local callback = data.callback or function() end

        local ButtonBG = Instance.new("TextButton")
        ButtonBG.Size = UDim2.new(1, 0, 0, 45)
        ButtonBG.BackgroundColor3 = Colors.ElementBG
        ButtonBG.Text = text
        ButtonBG.TextColor3 = Colors.Text
        ButtonBG.TextSize = 14
        ButtonBG.Font = Enum.Font.GothamMedium
        ButtonBG.AutoButtonColor = false
        ButtonBG.ClipsDescendants = true
        ButtonBG.Parent = ScrollFrame
        Instance.new("UICorner", ButtonBG).CornerRadius = UDim.new(0, 8)
        Instance.new("UIStroke", ButtonBG).Color = Colors.Stroke

        ButtonBG.MouseEnter:Connect(function() TweenService:Create(ButtonBG, TweenInfo.new(0.2), {BackgroundColor3 = Colors.ElementHover}):Play() end)
        ButtonBG.MouseLeave:Connect(function() TweenService:Create(ButtonBG, TweenInfo.new(0.2), {BackgroundColor3 = Colors.ElementBG}):Play() end)
        
        ButtonBG.MouseButton1Click:Connect(function()
            local mouseLoc = UserInputService:GetMouseLocation()
            CreateRipple(ButtonBG, mouseLoc.X, mouseLoc.Y - 36)
            
            TweenService:Create(ButtonBG, TweenInfo.new(0.1), {TextSize = 12, TextColor3 = Colors.Accent}):Play()
            task.wait(0.1)
            TweenService:Create(ButtonBG, TweenInfo.new(0.2), {TextSize = 14, TextColor3 = Colors.Text}):Play()
            callback()
        end)
    end

    function Window:AddTextBox(data)
        local text = data.text or "TextBox"
        local placeholder = data.placeholder or "Type here..."
        local callback = data.callback or function() end

        local TBFrame = Instance.new("Frame")
        TBFrame.Size = UDim2.new(1, 0, 0, 50)
        TBFrame.BackgroundColor3 = Colors.ElementBG
        TBFrame.Parent = ScrollFrame
        Instance.new("UICorner", TBFrame).CornerRadius = UDim.new(0, 8)
        local FrameStroke = Instance.new("UIStroke", TBFrame)
        FrameStroke.Color = Colors.Stroke

        local Label = Instance.new("TextLabel")
        Label.Size = UDim2.new(0.4, 0, 1, 0)
        Label.Position = UDim2.new(0, 15, 0, 0)
        Label.BackgroundTransparency = 1
        Label.Text = text
        Label.TextColor3 = Colors.Text
        Label.TextSize = 14
        Label.Font = Enum.Font.GothamMedium
        Label.TextXAlignment = Enum.TextXAlignment.Left
        Label.Parent = TBFrame

        local TextBoxBG = Instance.new("Frame")
        TextBoxBG.Size = UDim2.new(0.55, -15, 0, 32)
        TextBoxBG.Position = UDim2.new(0.45, 0, 0.5, -16)
        TextBoxBG.BackgroundColor3 = Colors.Background
        TextBoxBG.Parent = TBFrame
        Instance.new("UICorner", TextBoxBG).CornerRadius = UDim.new(0, 6)
        local BoxStroke = Instance.new("UIStroke", TextBoxBG)
        BoxStroke.Color = Colors.Stroke

        local TextBox = Instance.new("TextBox")
        TextBox.Size = UDim2.new(1, -10, 1, 0)
        TextBox.Position = UDim2.new(0, 5, 0, 0)
        TextBox.BackgroundTransparency = 1
        TextBox.Text = ""
        TextBox.PlaceholderText = placeholder
        TextBox.PlaceholderColor3 = Colors.TextMuted
        TextBox.TextColor3 = Colors.Text
        TextBox.TextSize = 13
        TextBox.Font = Enum.Font.Gotham
        TextBox.Parent = TextBoxBG

        TextBox.Focused:Connect(function()
            TweenService:Create(BoxStroke, TweenInfo.new(0.3), {Color = Colors.Accent, Thickness = 1.5}):Play()
            TweenService:Create(TextBoxBG, TweenInfo.new(0.3), {BackgroundColor3 = Colors.ElementHover}):Play()
        end)

        TextBox.FocusLost:Connect(function()
            TweenService:Create(BoxStroke, TweenInfo.new(0.3), {Color = Colors.Stroke, Thickness = 1}):Play()
            TweenService:Create(TextBoxBG, TweenInfo.new(0.3), {BackgroundColor3 = Colors.Background}):Play()
            callback(TextBox.Text)
        end)
    end

    function Window:AddSlider(data)
        local text = data.text or "Slider"
        local min = data.min or 0
        local max = data.max or 100
        local default = data.default or min
        local callback = data.callback or function() end

        local SliderFrame = Instance.new("Frame")
        SliderFrame.Size = UDim2.new(1, 0, 0, 60)
        SliderFrame.BackgroundColor3 = Colors.ElementBG
        SliderFrame.Parent = ScrollFrame
        Instance.new("UICorner", SliderFrame).CornerRadius = UDim.new(0, 8)
        Instance.new("UIStroke", SliderFrame).Color = Colors.Stroke

        local Label = Instance.new("TextLabel")
        Label.Size = UDim2.new(1, -30, 0, 30)
        Label.Position = UDim2.new(0, 15, 0, 0)
        Label.BackgroundTransparency = 1
        Label.Text = text
        Label.TextColor3 = Colors.Text
        Label.TextSize = 14
        Label.Font = Enum.Font.GothamMedium
        Label.TextXAlignment = Enum.TextXAlignment.Left
        Label.Parent = SliderFrame

        local ValueLabel = Instance.new("TextLabel")
        ValueLabel.Size = UDim2.new(0, 50, 0, 30)
        ValueLabel.Position = UDim2.new(1, -65, 0, 0)
        ValueLabel.BackgroundTransparency = 1
        ValueLabel.Text = tostring(default)
        ValueLabel.TextColor3 = Colors.Accent
        ValueLabel.TextSize = 14
        ValueLabel.Font = Enum.Font.GothamBold
        ValueLabel.TextXAlignment = Enum.TextXAlignment.Right
        ValueLabel.Parent = SliderFrame

        local SliderBG = Instance.new("TextButton")
        SliderBG.Size = UDim2.new(1, -30, 0, 6)
        SliderBG.Position = UDim2.new(0, 15, 0, 40)
        SliderBG.BackgroundColor3 = Colors.Background
        SliderBG.Text = ""
        SliderBG.AutoButtonColor = false
        SliderBG.Parent = SliderFrame
        Instance.new("UICorner", SliderBG).CornerRadius = UDim.new(1, 0)
        Instance.new("UIStroke", SliderBG).Color = Colors.Stroke

        local Fill = Instance.new("Frame")
        Fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
        Fill.BackgroundColor3 = Colors.Accent
        Fill.BorderSizePixel = 0
        Fill.Parent = SliderBG
        Instance.new("UICorner", Fill).CornerRadius = UDim.new(1, 0)
        
        local Knob = Instance.new("Frame")
        Knob.Size = UDim2.new(0, 14, 0, 14)
        Knob.Position = UDim2.new(1, -7, 0.5, -7)
        Knob.BackgroundColor3 = Colors.Text
        Knob.Parent = Fill
        Instance.new("UICorner", Knob).CornerRadius = UDim.new(1, 0)
        local KnobStroke = Instance.new("UIStroke", Knob)
        KnobStroke.Color = Colors.ElementBG
        KnobStroke.Thickness = 2

        local dragging = false
        local function UpdateSlider(input)
            local pos = math.clamp((input.Position.X - SliderBG.AbsolutePosition.X) / SliderBG.AbsoluteSize.X, 0, 1)
            local value = math.floor(min + ((max - min) * pos))
            TweenService:Create(Fill, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.new(pos, 0, 1, 0)}):Play()
            ValueLabel.Text = tostring(value)
            callback(value)
        end

        SliderBG.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                TweenService:Create(Knob, TweenInfo.new(0.3, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), {Size = UDim2.new(0, 18, 0, 18), Position = UDim2.new(1, -9, 0.5, -9)}):Play()
                UpdateSlider(input)
            end
        end)

        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
                TweenService:Create(Knob, TweenInfo.new(0.2), {Size = UDim2.new(0, 14, 0, 14), Position = UDim2.new(1, -7, 0.5, -7)}):Play()
            end
        end)

        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                UpdateSlider(input)
            end
        end)
    end

    function Window:AddLabel(data)
        local text = data.text or "Label"

        local LabelFrame = Instance.new("Frame")
        LabelFrame.Size = UDim2.new(1, 0, 0, 30)
        LabelFrame.BackgroundTransparency = 1
        LabelFrame.Parent = ScrollFrame

        local Label = Instance.new("TextLabel")
        Label.Size = UDim2.new(1, -20, 1, 0)
        Label.Position = UDim2.new(0, 10, 0, 0)
        Label.BackgroundTransparency = 1
        Label.Text = text
        Label.TextColor3 = Colors.TextMuted
        Label.TextSize = 13
        Label.Font = Enum.Font.GothamMedium
        Label.TextWrapped = true
        Label.Parent = LabelFrame
    end

    function Window:Init()
        -- Пустая функция для обратной совместимости
    end

    return Window
end

return Library
