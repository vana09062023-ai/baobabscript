local CoreGui = game:GetService("CoreGui")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local Library = {}

function Library:CreateWindow(titleText)
    local guiName = titleText or "Baobab Hub"
    if CoreGui:FindFirstChild(guiName) then
        CoreGui[guiName]:Destroy()
    end

    -- Цветовая палитра
    local Colors = {
        Background = Color3.fromRGB(15, 15, 18),
        ElementBG = Color3.fromRGB(24, 24, 28),
        ElementHover = Color3.fromRGB(30, 30, 35),
        Stroke = Color3.fromRGB(45, 45, 52),
        Accent = Color3.fromRGB(85, 115, 255),
        Text = Color3.fromRGB(240, 240, 245),
        TextMuted = Color3.fromRGB(150, 150, 160)
    }

    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = guiName
    ScreenGui.ResetOnSpawn = false
    ScreenGui.Parent = CoreGui

    local MainFrame = Instance.new("Frame")
    MainFrame.Name = "MainFrame"
    MainFrame.Size = UDim2.new(0, 340, 0, 420)
    MainFrame.Position = UDim2.new(0.5, -170, 0.5, -210)
    MainFrame.BackgroundColor3 = Colors.Background
    MainFrame.BorderSizePixel = 0
    MainFrame.ClipsDescendants = true -- Важно для красивого обрезания при сворачивании
    MainFrame.Parent = ScreenGui

    local UICorner = Instance.new("UICorner")
    UICorner.CornerRadius = UDim.new(0, 10)
    UICorner.Parent = MainFrame

    local UIStroke = Instance.new("UIStroke")
    UIStroke.Parent = MainFrame
    UIStroke.Color = Colors.Stroke
    UIStroke.Thickness = 1.5

    local TopBar = Instance.new("Frame")
    TopBar.Size = UDim2.new(1, 0, 0, 45)
    TopBar.BackgroundTransparency = 1
    TopBar.Parent = MainFrame

    local Title = Instance.new("TextLabel")
    Title.Size = UDim2.new(1, -60, 1, 0)
    Title.Position = UDim2.new(0, 20, 0, 0)
    Title.BackgroundTransparency = 1
    Title.Text = titleText or "Hub"
    Title.TextColor3 = Colors.Text
    Title.TextSize = 16
    Title.Font = Enum.Font.GothamBold
    Title.TextXAlignment = Enum.TextXAlignment.Left
    Title.Parent = TopBar

    -- Красивая кнопка сворачивания
    local MinimizeBtn = Instance.new("TextButton")
    MinimizeBtn.Size = UDim2.new(0, 45, 0, 45)
    MinimizeBtn.Position = UDim2.new(1, -45, 0, 0)
    MinimizeBtn.BackgroundTransparency = 1
    MinimizeBtn.Text = "−"
    MinimizeBtn.TextColor3 = Colors.TextMuted
    MinimizeBtn.TextSize = 22
    MinimizeBtn.Font = Enum.Font.GothamBold
    MinimizeBtn.Parent = TopBar

    -- Анимация наведения для кнопки сворачивания
    MinimizeBtn.MouseEnter:Connect(function()
        TweenService:Create(MinimizeBtn, TweenInfo.new(0.2), {TextColor3 = Colors.Text}):Play()
    end)
    MinimizeBtn.MouseLeave:Connect(function()
        TweenService:Create(MinimizeBtn, TweenInfo.new(0.2), {TextColor3 = Colors.TextMuted}):Play()
    end)

    local Divider = Instance.new("Frame")
    Divider.Size = UDim2.new(1, 0, 0, 1)
    Divider.Position = UDim2.new(0, 0, 1, 0)
    Divider.BackgroundColor3 = Colors.Stroke
    Divider.BorderSizePixel = 0
    Divider.Parent = TopBar

    local BottomLabel = Instance.new("TextLabel")
    BottomLabel.Size = UDim2.new(1, 0, 0, 30)
    -- Изменил привязку: теперь отсчет идет сверху, чтобы при сворачивании текст не прыгал вверх!
    BottomLabel.Position = UDim2.new(0, 0, 0, 390) 
    BottomLabel.BackgroundTransparency = 1
    BottomLabel.Text = "discord.gg/CVxS3dH5fz"
    BottomLabel.TextColor3 = Colors.TextMuted
    BottomLabel.TextSize = 12
    BottomLabel.Font = Enum.Font.GothamMedium
    BottomLabel.Parent = MainFrame

    local ScrollFrame = Instance.new("ScrollingFrame")
    ScrollFrame.Size = UDim2.new(1, 0, 0, 343) -- Жесткий размер вместо Scale, чтобы элементы не сжимались при сворачивании
    ScrollFrame.Position = UDim2.new(0, 0, 0, 46)
    ScrollFrame.BackgroundTransparency = 1
    ScrollFrame.ScrollBarThickness = 4
    ScrollFrame.ScrollBarImageColor3 = Colors.Stroke
    ScrollFrame.BorderSizePixel = 0
    ScrollFrame.Parent = MainFrame

    local UIPadding = Instance.new("UIPadding")
    UIPadding.PaddingLeft = UDim.new(0, 12)
    UIPadding.PaddingRight = UDim.new(0, 12)
    UIPadding.PaddingTop = UDim.new(0, 12)
    UIPadding.PaddingBottom = UDim.new(0, 12)
    UIPadding.Parent = ScrollFrame

    local UIListLayout = Instance.new("UIListLayout")
    UIListLayout.Padding = UDim.new(0, 10)
    UIListLayout.SortOrder = Enum.SortOrder.LayoutOrder
    UIListLayout.Parent = ScrollFrame

    UIListLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        ScrollFrame.CanvasSize = UDim2.new(0, 0, 0, UIListLayout.AbsoluteContentSize.Y + 24)
    end)

    -- Перетаскивание окна
    local dragging, dragInput, dragStart, startPos
    TopBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = MainFrame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    TopBar.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then dragInput = input end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            TweenService:Create(MainFrame, TweenInfo.new(0.08, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
                Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            }):Play()
        end
    end)

    -- Улучшенная логика сворачивания (Плавная)
    local minimized = false
    MinimizeBtn.MouseButton1Click:Connect(function()
        minimized = not minimized
        if minimized then
            -- Анимация кнопки: вращаем и меняем на плюс
            MinimizeBtn.Text = "+"
            TweenService:Create(MinimizeBtn, TweenInfo.new(0.4, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), {Rotation = 90}):Play()
            
            -- Сворачиваем окно плавно (Exponential делает анимацию "сочной")
            TweenService:Create(MainFrame, TweenInfo.new(0.5, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), {Size = UDim2.new(0, 340, 0, 45)}):Play()
            
            -- Прячем скроллбар и нижний текст, чтобы не мелькали
            TweenService:Create(BottomLabel, TweenInfo.new(0.2), {TextTransparency = 1}):Play()
            TweenService:Create(ScrollFrame, TweenInfo.new(0.2), {ScrollBarImageTransparency = 1}):Play()
        else
            -- Возвращаем минус
            MinimizeBtn.Text = "−"
            TweenService:Create(MinimizeBtn, TweenInfo.new(0.4, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), {Rotation = 0}):Play()
            
            -- Разворачиваем
            TweenService:Create(MainFrame, TweenInfo.new(0.5, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), {Size = UDim2.new(0, 340, 0, 420)}):Play()
            
            -- Возвращаем видимость элементов
            TweenService:Create(BottomLabel, TweenInfo.new(0.4), {TextTransparency = 0}):Play()
            TweenService:Create(ScrollFrame, TweenInfo.new(0.4), {ScrollBarImageTransparency = 0}):Play()
        end
    end)

    -- Скрытие UI на правый Shift
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if not gameProcessed and input.KeyCode == Enum.KeyCode.RightShift then
            ScreenGui.Enabled = not ScreenGui.Enabled
        end
    end)

    local Window = {}

    function Window:AddToggle(data)
        local text = data.text or "Toggle"
        local defaultState = data.state or false
        local callback = data.callback or function() end

        local ToggleFrame = Instance.new("TextButton")
        ToggleFrame.Size = UDim2.new(1, 0, 0, 42)
        ToggleFrame.BackgroundColor3 = Colors.ElementBG
        ToggleFrame.AutoButtonColor = false
        ToggleFrame.Text = ""
        ToggleFrame.Parent = ScrollFrame
        Instance.new("UICorner", ToggleFrame).CornerRadius = UDim.new(0, 8)

        local UIStrokeToggle = Instance.new("UIStroke")
        UIStrokeToggle.Parent = ToggleFrame
        UIStrokeToggle.Color = Colors.Stroke
        UIStrokeToggle.Thickness = 1

        local Label = Instance.new("TextLabel")
        Label.Size = UDim2.new(1, -70, 1, 0)
        Label.Position = UDim2.new(0, 15, 0, 0)
        Label.BackgroundTransparency = 1
        Label.Text = text
        Label.TextColor3 = Colors.Text
        Label.TextSize = 13
        Label.Font = Enum.Font.GothamMedium
        Label.TextXAlignment = Enum.TextXAlignment.Left
        Label.Parent = ToggleFrame

        local ToggleBG = Instance.new("Frame")
        ToggleBG.Size = UDim2.new(0, 44, 0, 22)
        ToggleBG.Position = UDim2.new(1, -56, 0.5, -11)
        ToggleBG.BackgroundColor3 = defaultState and Colors.Accent or Color3.fromRGB(50, 50, 55)
        ToggleBG.Parent = ToggleFrame
        Instance.new("UICorner", ToggleBG).CornerRadius = UDim.new(1, 0)

        local Circle = Instance.new("Frame")
        Circle.Size = UDim2.new(0, 16, 0, 16)
        Circle.Position = UDim2.new(defaultState and 1 or 0, defaultState and -19 or 3, 0.5, -8)
        Circle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        Circle.Parent = ToggleBG
        Instance.new("UICorner", Circle).CornerRadius = UDim.new(1, 0)

        ToggleFrame.MouseEnter:Connect(function()
            TweenService:Create(ToggleFrame, TweenInfo.new(0.2), {BackgroundColor3 = Colors.ElementHover}):Play()
        end)
        ToggleFrame.MouseLeave:Connect(function()
            TweenService:Create(ToggleFrame, TweenInfo.new(0.2), {BackgroundColor3 = Colors.ElementBG}):Play()
        end)

        local state = defaultState
        local function Fire()
            state = not state
            local targetColor = state and Colors.Accent or Color3.fromRGB(50, 50, 55)
            local targetPos = state and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)
            
            TweenService:Create(ToggleBG, TweenInfo.new(0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {BackgroundColor3 = targetColor}):Play()
            TweenService:Create(Circle, TweenInfo.new(0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Position = targetPos}):Play()
            callback(state)
        end
        ToggleFrame.MouseButton1Click:Connect(Fire)
    end

    function Window:AddButton(data)
        local text = data.text or "Button"
        local callback = data.callback or function() end

        local ButtonBG = Instance.new("TextButton")
        ButtonBG.Size = UDim2.new(1, 0, 0, 42)
        ButtonBG.BackgroundColor3 = Colors.ElementBG
        ButtonBG.Text = text
        ButtonBG.TextColor3 = Colors.Text
        ButtonBG.TextSize = 13
        ButtonBG.Font = Enum.Font.GothamMedium
        ButtonBG.AutoButtonColor = false
        ButtonBG.Parent = ScrollFrame
        Instance.new("UICorner", ButtonBG).CornerRadius = UDim.new(0, 8)

        local UIStrokeBtn = Instance.new("UIStroke")
        UIStrokeBtn.Parent = ButtonBG
        UIStrokeBtn.Color = Colors.Stroke
        UIStrokeBtn.Thickness = 1

        ButtonBG.MouseEnter:Connect(function()
            TweenService:Create(ButtonBG, TweenInfo.new(0.15), {BackgroundColor3 = Colors.ElementHover}):Play()
        end)
        ButtonBG.MouseLeave:Connect(function()
            TweenService:Create(ButtonBG, TweenInfo.new(0.15), {BackgroundColor3 = Colors.ElementBG}):Play()
        end)
        ButtonBG.MouseButton1Down:Connect(function()
            TweenService:Create(ButtonBG, TweenInfo.new(0.1), {BackgroundColor3 = Colors.Stroke, TextSize = 12}):Play()
        end)
        ButtonBG.MouseButton1Up:Connect(function()
            TweenService:Create(ButtonBG, TweenInfo.new(0.1), {BackgroundColor3 = Colors.ElementHover, TextSize = 13}):Play()
        end)
        ButtonBG.MouseButton1Click:Connect(callback)
    end

    return Window
end

return Library
