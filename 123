local CoreGui = game:GetService("CoreGui")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local Library = {}

-- Глобальная палитра (Modern Dark)
local Colors = {
    MainBG = Color3.fromRGB(15, 15, 18),
    SidebarBG = Color3.fromRGB(20, 20, 24),
    ElementBG = Color3.fromRGB(26, 26, 32),
    Hover = Color3.fromRGB(34, 34, 42),
    Stroke = Color3.fromRGB(45, 45, 55),
    Accent = Color3.fromRGB(108, 92, 231), -- Мягкий фиолетовый
    Text = Color3.fromRGB(240, 240, 240),
    TextDark = Color3.fromRGB(140, 140, 150)
}

function Library:Notify(title, text, duration)
    -- Простая система уведомлений (создается на лету)
    local screen = CoreGui:FindFirstChild("Baobab_Notifications") 
    if not screen then
        screen = Instance.new("ScreenGui", CoreGui)
        screen.Name = "Baobab_Notifications"
    end

    local NotifFrame = Instance.new("Frame", screen)
    NotifFrame.Size = UDim2.new(0, 250, 0, 70)
    NotifFrame.Position = UDim2.new(1, 10, 1, -90) -- За экраном
    NotifFrame.BackgroundColor3 = Colors.SidebarBG
    Instance.new("UICorner", NotifFrame).CornerRadius = UDim.new(0, 6)
    Instance.new("UIStroke", NotifFrame).Color = Colors.Stroke

    local TitleLbl = Instance.new("TextLabel", NotifFrame)
    TitleLbl.Size = UDim2.new(1, -20, 0, 25)
    TitleLbl.Position = UDim2.new(0, 10, 0, 5)
    TitleLbl.BackgroundTransparency = 1
    TitleLbl.Text = title
    TitleLbl.TextColor3 = Colors.Accent
    TitleLbl.Font = Enum.Font.GothamBold
    TitleLbl.TextSize = 14
    TitleLbl.TextXAlignment = Enum.TextXAlignment.Left

    local DescLbl = Instance.new("TextLabel", NotifFrame)
    DescLbl.Size = UDim2.new(1, -20, 0, 35)
    DescLbl.Position = UDim2.new(0, 10, 0, 25)
    DescLbl.BackgroundTransparency = 1
    DescLbl.Text = text
    DescLbl.TextColor3 = Colors.Text
    DescLbl.Font = Enum.Font.Gotham
    DescLbl.TextSize = 12
    DescLbl.TextXAlignment = Enum.TextXAlignment.Left
    DescLbl.TextWrapped = true

    -- Выезд уведомления
    TweenService:Create(NotifFrame, TweenInfo.new(0.5, Enum.EasingStyle.Quint), {Position = UDim2.new(1, -270, 1, -90)}):Play()
    
    task.delay(duration or 3, function()
        TweenService:Create(NotifFrame, TweenInfo.new(0.5, Enum.EasingStyle.Quint), {Position = UDim2.new(1, 10, 1, -90)}):Play()
        task.wait(0.5)
        NotifFrame:Destroy()
    end)
end

function Library:CreateWindow(options)
    local titleText = options.Name or "Baobab Hub"
    local guiName = "Baobab_Global_UI"

    if CoreGui:FindFirstChild(guiName) then
        CoreGui[guiName]:Destroy()
    end

    local ScreenGui = Instance.new("ScreenGui", CoreGui)
    ScreenGui.Name = guiName
    ScreenGui.ResetOnSpawn = false

    -- ГЛАВНОЕ ОКНО
    local MainFrame = Instance.new("Frame", ScreenGui)
    MainFrame.Size = UDim2.new(0, 550, 0, 380)
    MainFrame.Position = UDim2.new(0.5, -275, 0.5, -190)
    MainFrame.BackgroundColor3 = Colors.MainBG
    MainFrame.ClipsDescendants = true
    Instance.new("UICorner", MainFrame).CornerRadius = UDim.new(0, 8)
    Instance.new("UIStroke", MainFrame).Color = Colors.Stroke

    -- САЙДБАР (Левая панель навигации)
    local Sidebar = Instance.new("Frame", MainFrame)
    Sidebar.Size = UDim2.new(0, 150, 1, 0)
    Sidebar.BackgroundColor3 = Colors.SidebarBG
    Sidebar.BorderSizePixel = 0

    local SidebarLine = Instance.new("Frame", Sidebar)
    SidebarLine.Size = UDim2.new(0, 1, 1, 0)
    SidebarLine.Position = UDim2.new(1, 0, 0, 0)
    SidebarLine.BackgroundColor3 = Colors.Stroke
    SidebarLine.BorderSizePixel = 0

    local Title = Instance.new("TextLabel", Sidebar)
    Title.Size = UDim2.new(1, 0, 0, 50)
    Title.BackgroundTransparency = 1
    Title.Text = titleText
    Title.TextColor3 = Colors.Accent
    Title.Font = Enum.Font.GothamBold
    Title.TextSize = 16

    local TabContainer = Instance.new("ScrollingFrame", Sidebar)
    TabContainer.Size = UDim2.new(1, 0, 1, -80)
    TabContainer.Position = UDim2.new(0, 0, 0, 50)
    TabContainer.BackgroundTransparency = 1
    TabContainer.ScrollBarThickness = 0
    
    local TabListLayout = Instance.new("UIListLayout", TabContainer)
    TabListLayout.Padding = UDim.new(0, 5)
    TabListLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center

    local DiscordLabel = Instance.new("TextLabel", Sidebar)
    DiscordLabel.Size = UDim2.new(1, 0, 0, 30)
    DiscordLabel.Position = UDim2.new(0, 0, 1, -30)
    DiscordLabel.BackgroundTransparency = 1
    DiscordLabel.Text = "discord.gg/baobab"
    DiscordLabel.TextColor3 = Colors.TextDark
    DiscordLabel.Font = Enum.Font.Gotham
    DiscordLabel.TextSize = 10

    -- КОНТЕНТ (Правая часть)
    local ContentArea = Instance.new("Frame", MainFrame)
    ContentArea.Size = UDim2.new(1, -150, 1, 0)
    ContentArea.Position = UDim2.new(0, 150, 0, 0)
    ContentArea.BackgroundTransparency = 1

    local TopDragArea = Instance.new("Frame", ContentArea)
    TopDragArea.Size = UDim2.new(1, 0, 0, 40)
    TopDragArea.BackgroundTransparency = 1

    local PageFolder = Instance.new("Folder", ContentArea)

    -- ЛОГИКА ДРАГА
    local dragging, dragInput, dragStart, startPos
    TopDragArea.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = MainFrame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    TopDragArea.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement then dragInput = input end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    local Window = {
        CurrentTab = nil,
        Tabs = {}
    }

    function Window:CreateTab(tabName)
        local TabBtn = Instance.new("TextButton", TabContainer)
        TabBtn.Size = UDim2.new(0, 130, 0, 32)
        TabBtn.BackgroundColor3 = Colors.ElementBG
        TabBtn.Text = tabName
        TabBtn.TextColor3 = Colors.TextDark
        TabBtn.Font = Enum.Font.GothamMedium
        TabBtn.TextSize = 13
        TabBtn.AutoButtonColor = false
        Instance.new("UICorner", TabBtn).CornerRadius = UDim.new(0, 6)

        local Page = Instance.new("ScrollingFrame", PageFolder)
        Page.Size = UDim2.new(1, 0, 1, -40)
        Page.Position = UDim2.new(0, 0, 0, 40)
        Page.BackgroundTransparency = 1
        Page.ScrollBarThickness = 2
        Page.ScrollBarImageColor3 = Colors.Stroke
        Page.Visible = false

        Instance.new("UIPadding", Page).PaddingTop = UDim.new(0, 10)
        Instance.new("UIPadding", Page).PaddingLeft = UDim.new(0, 15)
        Instance.new("UIPadding", Page).PaddingRight = UDim.new(0, 15)
        
        local PageLayout = Instance.new("UIListLayout", Page)
        PageLayout.Padding = UDim.new(0, 8)
        PageLayout.SortOrder = Enum.SortOrder.LayoutOrder

        PageLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            Page.CanvasSize = UDim2.new(0, 0, 0, PageLayout.AbsoluteContentSize.Y + 20)
        end)

        TabBtn.MouseButton1Click:Connect(function()
            for _, t in pairs(Window.Tabs) do
                t.Page.Visible = false
                TweenService:Create(t.Btn, TweenInfo.new(0.2), {BackgroundColor3 = Colors.ElementBG, TextColor3 = Colors.TextDark}):Play()
            end
            Page.Visible = true
            Window.CurrentTab = tabName
            TweenService:Create(TabBtn, TweenInfo.new(0.2), {BackgroundColor3 = Colors.Accent, TextColor3 = Color3.new(1,1,1)}):Play()
        end)

        local Tab = {
            Btn = TabBtn,
            Page = Page
        }
        table.insert(Window.Tabs, Tab)

        -- Если это первая вкладка, активируем ее
        if #Window.Tabs == 1 then
            Page.Visible = true
            TabBtn.BackgroundColor3 = Colors.Accent
            TabBtn.TextColor3 = Color3.new(1,1,1)
        end

        local Elements = {}

        function Elements:AddButton(text, callback)
            local Btn = Instance.new("TextButton", Page)
            Btn.Size = UDim2.new(1, 0, 0, 38)
            Btn.BackgroundColor3 = Colors.ElementBG
            Btn.Text = text
            Btn.TextColor3 = Colors.Text
            Btn.Font = Enum.Font.GothamMedium
            Btn.TextSize = 13
            Btn.AutoButtonColor = false
            Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 6)
            Instance.new("UIStroke", Btn).Color = Colors.Stroke

            Btn.MouseEnter:Connect(function() TweenService:Create(Btn, TweenInfo.new(0.15), {BackgroundColor3 = Colors.Hover}):Play() end)
            Btn.MouseLeave:Connect(function() TweenService:Create(Btn, TweenInfo.new(0.15), {BackgroundColor3 = Colors.ElementBG}):Play() end)
            Btn.MouseButton1Click:Connect(function()
                TweenService:Create(Btn, TweenInfo.new(0.1), {TextSize = 11}):Play()
                task.wait(0.1)
                TweenService:Create(Btn, TweenInfo.new(0.1), {TextSize = 13}):Play()
                if callback then callback() end
            end)
        end

        function Elements:AddToggle(text, default, callback)
            local state = default or false
            local ToggleBG = Instance.new("TextButton", Page)
            ToggleBG.Size = UDim2.new(1, 0, 0, 38)
            ToggleBG.BackgroundColor3 = Colors.ElementBG
            ToggleBG.Text = ""
            ToggleBG.AutoButtonColor = false
            Instance.new("UICorner", ToggleBG).CornerRadius = UDim.new(0, 6)
            Instance.new("UIStroke", ToggleBG).Color = Colors.Stroke

            local Label = Instance.new("TextLabel", ToggleBG)
            Label.Size = UDim2.new(1, -60, 1, 0)
            Label.Position = UDim2.new(0, 15, 0, 0)
            Label.BackgroundTransparency = 1
            Label.Text = text
            Label.TextColor3 = Colors.Text
            Label.Font = Enum.Font.GothamMedium
            Label.TextSize = 13
            Label.TextXAlignment = Enum.TextXAlignment.Left

            local Switch = Instance.new("Frame", ToggleBG)
            Switch.Size = UDim2.new(0, 36, 0, 18)
            Switch.Position = UDim2.new(1, -50, 0.5, -9)
            Switch.BackgroundColor3 = state and Colors.Accent or Colors.MainBG
            Instance.new("UICorner", Switch).CornerRadius = UDim.new(1, 0)
            local SwitchStroke = Instance.new("UIStroke", Switch)
            SwitchStroke.Color = Colors.Stroke
            SwitchStroke.Transparency = state and 1 or 0

            local Circle = Instance.new("Frame", Switch)
            Circle.Size = UDim2.new(0, 14, 0, 14)
            Circle.Position = UDim2.new(state and 1 or 0, state and -16 or 2, 0.5, -7)
            Circle.BackgroundColor3 = Colors.Text
            Instance.new("UICorner", Circle).CornerRadius = UDim.new(1, 0)

            ToggleBG.MouseButton1Click:Connect(function()
                state = not state
                TweenService:Create(Switch, TweenInfo.new(0.2), {BackgroundColor3 = state and Colors.Accent or Colors.MainBG}):Play()
                TweenService:Create(SwitchStroke, TweenInfo.new(0.2), {Transparency = state and 1 or 0}):Play()
                TweenService:Create(Circle, TweenInfo.new(0.2), {Position = UDim2.new(state and 1 or 0, state and -16 or 2, 0.5, -7)}):Play()
                if callback then callback(state) end
            end)
        end

        function Elements:AddDropdown(text, list, callback)
            local dropDownOpen = false
            local DropBG = Instance.new("TextButton", Page)
            DropBG.Size = UDim2.new(1, 0, 0, 38)
            DropBG.BackgroundColor3 = Colors.ElementBG
            DropBG.Text = ""
            DropBG.AutoButtonColor = false
            DropBG.ClipsDescendants = true
            Instance.new("UICorner", DropBG).CornerRadius = UDim.new(0, 6)
            Instance.new("UIStroke", DropBG).Color = Colors.Stroke

            local Label = Instance.new("TextLabel", DropBG)
            Label.Size = UDim2.new(1, -40, 0, 38)
            Label.Position = UDim2.new(0, 15, 0, 0)
            Label.BackgroundTransparency = 1
            Label.Text = text .. " : None"
            Label.TextColor3 = Colors.Text
            Label.Font = Enum.Font.GothamMedium
            Label.TextSize = 13
            Label.TextXAlignment = Enum.TextXAlignment.Left

            local Arrow = Instance.new("TextLabel", DropBG)
            Arrow.Size = UDim2.new(0, 38, 0, 38)
            Arrow.Position = UDim2.new(1, -38, 0, 0)
            Arrow.BackgroundTransparency = 1
            Arrow.Text = "▼"
            Arrow.TextColor3 = Colors.TextDark
            Arrow.Font = Enum.Font.GothamBold
            Arrow.TextSize = 12

            local ListContainer = Instance.new("Frame", DropBG)
            ListContainer.Size = UDim2.new(1, -20, 0, 0)
            ListContainer.Position = UDim2.new(0, 10, 0, 38)
            ListContainer.BackgroundTransparency = 1
            
            local ListLayout = Instance.new("UIListLayout", ListContainer)
            ListLayout.Padding = UDim.new(0, 4)

            for _, itemName in ipairs(list) do
                local ItemBtn = Instance.new("TextButton", ListContainer)
                ItemBtn.Size = UDim2.new(1, 0, 0, 30)
                ItemBtn.BackgroundColor3 = Colors.Hover
                ItemBtn.Text = itemName
                ItemBtn.TextColor3 = Colors.TextDark
                ItemBtn.Font = Enum.Font.Gotham
                ItemBtn.TextSize = 12
                Instance.new("UICorner", ItemBtn).CornerRadius = UDim.new(0, 4)

                ItemBtn.MouseButton1Click:Connect(function()
                    Label.Text = text .. " : " .. itemName
                    dropDownOpen = false
                    TweenService:Create(DropBG, TweenInfo.new(0.3), {Size = UDim2.new(1, 0, 0, 38)}):Play()
                    TweenService:Create(Arrow, TweenInfo.new(0.3), {Rotation = 0}):Play()
                    if callback then callback(itemName) end
                end)
            end

            local totalHeight = 38 + (#list * 34)

            DropBG.MouseButton1Click:Connect(function()
                dropDownOpen = not dropDownOpen
                if dropDownOpen then
                    TweenService:Create(DropBG, TweenInfo.new(0.3, Enum.EasingStyle.Quint), {Size = UDim2.new(1, 0, 0, totalHeight)}):Play()
                    TweenService:Create(Arrow, TweenInfo.new(0.3), {Rotation = 180}):Play()
                else
                    TweenService:Create(DropBG, TweenInfo.new(0.3, Enum.EasingStyle.Quint), {Size = UDim2.new(1, 0, 0, 38)}):Play()
                    TweenService:Create(Arrow, TweenInfo.new(0.3), {Rotation = 0}):Play()
                end
            end)
        end

        return Elements
    end

    return Window
end

return Library
